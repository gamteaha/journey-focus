{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "journey-focus",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "build": { "command": "node cloudflare/build.mjs" },
  "assets": {
    "directory": "./dist/cloudflare",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api/*", "/map", "/map.html", "/cabin-frame", "/cabin-frame.html", "/alpine-pilot", "/alpine-pilot/", "/alpine-pilot/index.html", "/songdo", "/songdo/", "/songdo/index.html", "/desert", "/desert/", "/desert/index.html"]
  }
}
